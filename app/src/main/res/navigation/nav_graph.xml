<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.df.dicodingevent.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_navigation_home_to_detailEventFragment"
            app:destination="@id/detailEventFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_upcoming"
        android:name="com.df.dicodingevent.ui.UpcomingFragment"
        android:label="Upcoming"
        tools:layout="@layout/fragment_upcoming">
        <action
            android:id="@+id/action_navigation_upcoming_to_detailEventFragment"
            app:destination="@id/detailEventFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_finished"
        android:name="com.df.dicodingevent.ui.FinishedFragment"
        android:label="Finished"
        tools:layout="@layout/fragment_finished">
        <action
            android:id="@+id/action_navigation_finished_to_detailEventFragment"
            app:destination="@id/detailEventFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailEventFragment"
        android:name="com.df.dicodingevent.ui.DetailEventFragment"
        android:label="Detail Event"
        tools:layout="@layout/fragment_detail_event">
        <argument
            android:name="event"
            app:argType="com.df.dicodingevent.data.response.EventItem" />
        <argument
            android:name="isFinished"
            app:argType="boolean"
            android:defaultValue="false"/>

    </fragment>

</navigation>
